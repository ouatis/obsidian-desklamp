{
  "name": "obsidian-desklamp",
  "version": "0.4.5",
  "description": "Room lights off, one lamp left on.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "node --experimental-strip-types test/engine.test.mjs",
    "test:bundle": "node test/bundle.smoke.cjs",
    "test:ui:live": "node test/ui-live.mjs",
    "audit:deps": "npm audit --audit-level=moderate",
    "install:vault": "node scripts/install-vault.mjs",
    "verify": "npm run audit:deps && npm run typecheck && npm run lint && npm test && npm run build && npm run install:vault && npm run test:bundle",
    "lint": "eslint ."
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "writing",
    "focus"
  ],
  "author": "SigiL",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@types/node": "^22.10.2",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "globals": "^17.13.0",
    "jiti": "^2.7.0",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "moment": "^2.31.0"
  }
}
