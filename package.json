{
  "name": "obsidian-desklamp",
  "version": "0.4.0",
  "description": "Room lights off, one lamp left on.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "test": "node --experimental-strip-types test/engine.test.mjs",
    "test:bundle": "node test/bundle.smoke.cjs",
    "install:vault": "node scripts/install-vault.mjs",
    "verify": "npm run typecheck && npm test && npm run build && npm run install:vault && npm run test:bundle"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "writing",
    "focus"
  ],
  "author": "SigiL",
  "license": "MIT",
  "devDependencies": {
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.10.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.6",
    "@types/node": "^22.10.2",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.24.2",
    "obsidian": "^1.13.1",
    "tslib": "^2.8.1",
    "typescript": "^5.7.2"
  }
}
